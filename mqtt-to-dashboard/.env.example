# ============================================================================
# Copy this file to `.env` and fill in your Tiger Cloud connection details.
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Tiger Cloud (HOSTED — this is NOT running in Docker)
# ----------------------------------------------------------------------------
# Grab these from your service's "Connection info" panel in the Tiger Cloud
# console. They are also all present in the psql connection string:
#   postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
#                        \______/ \__/ \__/  \_/
#                          USER   HOST  PORT  DATABASE
TIGER_HOST=xxxxxxxxxx.xxxxxxxxxx.tsdb.cloud.timescale.com
TIGER_PORT=39966
TIGER_DATABASE=tsdb
TIGER_USER=tsdbadmin
TIGER_PASSWORD=your-password-here

# ----------------------------------------------------------------------------
# MQTT broker — the feed lives in a separate project (../data-producer).
# Pick ONE of the two setups below.
# ----------------------------------------------------------------------------
#
# (A) SHARED broker your instructor hosts (default for the workshop):
#   MQTT_BROKER_HOST=broker.yourworkshop.com
#   MQTT_BROKER_PORT=8883
#   MQTT_TLS=true
#   MQTT_USERNAME=attendee
#   MQTT_PASSWORD=<shared attendee password>
#
# (B) LOCAL broker you run yourself (../data-producer via `docker compose up`):
#   MQTT_BROKER_HOST=host.docker.internal
#   MQTT_BROKER_PORT=1883
#   MQTT_TLS=false   (and leave USERNAME/PASSWORD blank)
#
MQTT_BROKER_HOST=host.docker.internal
MQTT_BROKER_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
# Only needed if the shared broker uses a self-signed cert; blank = system trust
# (correct for a Let's Encrypt cert).
MQTT_CA_CERT=

# Base prefix for all workshop topics (workshop/plant1/line-a/mixer/temperature),
# and the wildcard the consumer subscribes to.
MQTT_TOPIC_BASE=workshop
MQTT_SUBSCRIBE=workshop/#

# ----------------------------------------------------------------------------
# Grafana
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
