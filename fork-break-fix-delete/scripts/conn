#!/usr/bin/env bash
#
# Resolve a Tiger Cloud service NAME to a connection string, password included.
#
#   psql "$(scripts/conn fbfd-original)" -f sql/2-baseline.sql
#   psql "$(scripts/conn fbfd-original --read-only)"
#
# Extra arguments are passed through to `tiger db connection-string`.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

name="${1:-}"
if [ -z "$name" ]; then
    echo "usage: scripts/conn <service-name> [extra tiger flags]" >&2
    exit 64
fi
shift

exec tiger db connection-string "$("$here/sid" "$name")" --with-password "$@"
