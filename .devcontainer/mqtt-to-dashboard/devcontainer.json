// Save this as .devcontainer/devcontainer.json in the workshop repo.
// Attendees just click "Open in GitHub Codespaces" on the repo — no local install needed.
{
  "name": "mqtt-to-dashboard-workshop",

  // Base image with Python already baked in. Swap the version if the workshop needs a specific one.
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    // Gives you real Docker-in-Docker inside the codespace — needed if the workshop
    // spins up a Postgres/TimescaleDB container, a broker, etc.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},

    // Git is already in the base image, but this pins a recent version + nice defaults
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },

    // Postgres client tools (psql) for anyone poking at the DB from the terminal
    "ghcr.io/devcontainers-contrib/features/postgresql-client:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",

        // SQL syntax highlighting + a lightweight query runner
        // (mssql extension works fine for generic SQL highlighting, not just SQL Server)
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",

        // Quality-of-life, not required but nice for a workshop
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": false
      }
    }
  },

  // Runs once when the codespace is created — good place to pip install workshop deps
  "postCreateCommand": "pip install --user -r requirements.txt || true",

  // Forward whatever port your demo Postgres/TimescaleDB container listens on
  "forwardPorts": [5432],

  // Keep the codespace lean — workshop attendees don't need a beefy machine
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
