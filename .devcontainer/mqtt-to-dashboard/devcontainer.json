// This is the devcontainer config for the mqtt-to-dashboard workshop.
// Lives at .devcontainer/mqtt-to-dashboard/devcontainer.json — this repo
// hosts multiple workshops, so each one gets its own subfolder under .devcontainer/.
// Attendees connect via the deep link in this workshop's README (skips the config picker).
{
  "name": "mqtt-to-dashboard-workshop",

  // Base image with Python already baked in. Swap the version if the workshop needs a specific one.
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    // Gives you real Docker-in-Docker inside the codespace — needed if the workshop
    // spins up a Postgres/TimescaleDB container, a broker, etc.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},

    // Git is already in the base image, but this pins a recent version + nice defaults
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",

        // SQL syntax highlighting + a lightweight query runner
        // (mssql extension works fine for generic SQL highlighting, not just SQL Server)
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",

        // Quality-of-life, not required but nice for a workshop
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": false
      }
    }
  },

  // Installs psql directly via apt instead of relying on the
  // ghcr.io/devcontainers-contrib/features/postgresql-client feature, which
  // failed to resolve during container creation (community feature registry
  // issue, not something in our control). Also installs workshop deps once
  // requirements.txt exists.
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql-client && pip install --user -r requirements.txt || true",

  // Forward whatever port your demo Postgres/TimescaleDB container listens on
  "forwardPorts": [5432],

  // Keep the codespace lean — workshop attendees don't need a beefy machine
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
