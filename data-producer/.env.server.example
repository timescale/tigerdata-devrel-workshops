# ============================================================================
# Copy to `.env.server` and fill in. Used by setup.sh and docker-compose.server.yml.
#   cp .env.server.example .env.server
# ============================================================================

# DNS name that points at this VM's public IP (an A record you control).
# Let's Encrypt issues the TLS cert for this name; attendees connect to it.
DOMAIN=broker.yourworkshop.com

# Email for the Let's Encrypt account (expiry notices).
CERTBOT_EMAIL=you@example.com

# Broker credentials. Use strong values — the attendee password is shared with
# ~100 people, and the producer password guards write access to the feed.
PRODUCER_PASSWORD=change-me-to-something-strong
ATTENDEE_PASSWORD=change-me-attendees-will-use-this
