# ============================================================================
# Local development config for the producer (docker-compose.yml).
#   cp .env.example .env
#
# For the PUBLIC deployment (broker + producer with TLS/auth), use
# .env.server.example + ./setup.sh instead.
# ============================================================================

MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_TOPIC_BASE=workshop
PRODUCER_INTERVAL_SECONDS=2

# Auth/TLS are only used when publishing to a hardened broker. The local broker
# above is anonymous + plaintext, so leave these unset.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
